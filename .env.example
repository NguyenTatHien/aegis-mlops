# --- Model / OOD ---
MODEL_SOURCE=local            # local | registry
MODEL_DEFAULT=roberta         # baseline | svm | roberta
OOD_ENABLED=true               # recalibrated at target_fpr=0.05 — see content/aegis_artifacts/ood_operating_points.json

# --- Paths (used when MODEL_SOURCE=local) ---
ARTIFACTS_DIR=/app/artifacts
ROBERTA_MODEL_DIR=/app/artifacts/roberta_final
BASELINE_DIR=/app/artifacts/baseline
OOD_CONFIG_PATH=/app/artifacts/ood_config.json

# --- MLflow (used when MODEL_SOURCE=registry) ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BASELINE_MODEL_URI=models:/aegis-baseline/Production
MLFLOW_ROBERTA_MODEL_URI=models:/aegis-roberta/Production

# --- API ---
API_MAX_TEXT_LENGTH=10000
API_MAX_BATCH_SIZE=32
API_TITLE=Aegis News Routing API
API_VERSION=v1

# --- Ports (compose) ---
API_PORT=8000
MLFLOW_PORT=5001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
